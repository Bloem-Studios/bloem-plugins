          "checksum": "0cf1bdd48ea0e6aaf3a5bf13ab049dc6f12337f8c9b16c8dd51ce5343bcf5555"
        },
        "linux/amd64": {
          "url": "https://github.com/Vondel-Media/vondel-plugin-manga-metadata/releases/download/v0.1.3/plugin-linux-amd64",
