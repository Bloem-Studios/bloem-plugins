nteger\"},\"audiobookbay_search_pages\":{\"default\":2,\"maximum\":5,\"minimum\":1,\"type\":\"integer\"},\"audiobookbay_trackers\":{\"default\":[\"udp://tracker.openbittorrent.com:80\",\"udp://opentor.org:2710\",\"udp://tracker.ccc.de:80\",\"udp://tracker.blackunicorn.xyz:6969\"],\"items\":{\"maxLength\":300,\"type\":\"string\"},\"maxItems\":20,\"type\":\"array\"},\"max_candidates\":{\"default\":10,\"maximum\":10,\"minimum\":3,\"type\":\"integer\"},\"min_author_coverage\":{\"default\":0.5,\"maximum\":1,\"minimum\":0,\"type\":\"number\"},\"min_title_coverage\":{\"default\":0.6,\"maximum\":1,\"minimum\":0.3,\"type\":\"number\"},\"nzbget_category\":{\"default\":\"bloem-audiobooks\",\"maxLength\":64,\"type\":\"string\"},\"nzbget_url\":{\"default\":\"\",\"maxLength\":4096,\"type\":\"string\"},\"nzbget_username\":{\"default\":\"\",\"maxLength\":256,\"type\":\"string\"},\"nzbking_base_url\":{\"default\":\"https://nzbking.com\",\"maxLength\":4096,\"type\":\"string\"},\"nzbking_enabled\":{\"default\":true,\"type\":\"boolean\"},\"nzbking_standalone\":{\"default\":true,\"type\":\"boolean\"},\"qbittorrent_category\":{\"default\":\"bloem-audiobooks\",\"maxLength\":64,\"type\":\"string\"},\"qbittorrent_save_root\":{\"default\":\"\",\"maxLength\":1024,\"type\":\"string\"},\"qbittorrent_stall_hours\":{\"default\":24,\"maximum\":720,\"minimum\":1,\"type\":\"integer\"},\"qbittorrent_url\":{\"default\":\"\",\"maxLength\":4096,\"type\":\"string\"},\"qbittorrent_username\":{\"default\":\"\",\"maxLength\":256,\"type\":\"string\"},\"verify_local_client_prefix\":{\"default\":\"\",\"maxLength\":1024,\"type\":\"string\"},\"verify_local_prefix\":{\"default\":\"\",\"maxLength\":1024,\"type\":\"string\"},\"verify_min_duration_minutes\":{\"default\":30,\"maximum\":6000,\"minimum\":0,\"type\":\"integer\"},\"verify_min_total_mb\":{\"default\":20,\"maximum\":10000,\"minimum\":0,\"type\":\"integer\"}},\"type\":\"object\"}",
                "admin_form": {
                  "fields": [
                    {
