            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "watch_sync_provider.v1",
            "id": "pastime",
            "display_name": "Pastime",
            "description": "Sends what you watch to Pastime.",
            "watch_sync_provider": {
              "auth_methods": [
                2
              ],
              "export_watched": true,
              "supported_media_types": [
                1,
                3,
                2
              ],
              "external_id_namespaces": [
                "tmdb",
                "imdb",
                "tvdb"
              ],
              "max_batch_size": 100,
              "import_favorites": true,
              "export_favorites": true,
              "remove_favorites": true,
              "import_watchlist": true,
              "export_watchlist": true,
              "remove_watchlist": true,
              "scrobble_playback": true,
              "import_ratings": true,
              "export_ratings": true
            }
          }
        ],
        "global_config_schema": [
          {
            "key": "pastime",
            "title": "Pastime server",
            "description": "Where Silo sends what connected profiles watch.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"pastime_url\":{\"type\":\"string\",\"maxLength\":255}},\"required\":[\"pastime_url\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "pastime_url",
                  "label": "Pastime address",
                  "description": "The address people open Pastime at, for example https://pastime.example.com.",
                  "control": 1,
                  "placeholder": "https://pastime.example.com",
                  "required": true,
                  "validation": {
                    "pattern": "^https://[^/?#@\\s]+/?$",
                    "max_length": 255
                  }
                }
              ]
            }
          }
        ],
        "presentation": {
          "display_name": "Pastime",
          "summary": "Sends playback, history, favourites, watchlist and ratings to Pastime.",
          "description_markdown": "Sends what each connected profile watches to Pastime: live playback, finished plays, favourites, watchlist and ratings. Pastime favourites, watchlist and ratings are added to Silo; a Pastime read never removes anything from Silo.",
          "setup_markdown": "1. Install the plugin and set **Pastime address** to the address people open Pastime at.\n2. Each person opens Pastime's **Connect Silo** page, creates a key for their Pastime profile, then in Silo switches to that profile, opens **Settings → Watch Providers**, chooses **Pastime** and pastes the key.\n\nA new key replaces the profile's previous one. Disconnecting in Silo stops sending; revoking the key in Pastime does too.",
          "homepage_url": "https://github.com/Bloem-Studios/bloem-plugins",
          "source_url": "https://github.com/Bloem-Studios/bloem-plugin-pastime",
          "support_url": "https://github.com/Bloem-Studios/bloem-plugins/issues",
          "changelog_url": "https://github.com/Bloem-Studios/bloem-plugins/releases",
          "publisher_name": "Bloem Studios",
          "publisher_url": "https://github.com/Bloem-Studios",
          "license_spdx": "LicenseRef-Bloem-Proprietary"
        }
      },
      "repo_url": "https://github.com/Bloem-Studios/bloem-plugins",
      "checksums_url": "https://github.com/Bloem-Studios/bloem-plugins/releases/download/pastime-v0.2.0/checksums.txt",
      "binaries": {
        "darwin/arm64": {
          "url": "https://github.com/Bloem-Studios/bloem-plugins/releases/download/pastime-v0.2.0/plugin-darwin-arm64",
