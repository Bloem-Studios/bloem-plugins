      "manifest": {
        "plugin_id": "bloem.requests.bookwarehouse",
        "version": "0.1.1",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "request_router.v1",
            "id": "bookwarehouse",
            "display_name": "Bookwarehouse ebook requests",
            "description": "Request ISBN ebooks and track backend acquisition independently of library presence.",
            "config_schema": [
              {
                "key": "connection",
                "title": "Bookwarehouse request connection",
                "json_schema": "{\"type\":\"object\",\"properties\":{\"allow_http\":{\"type\":\"boolean\",\"default\":false},\"allow_pdf\":{\"type\":\"boolean\",\"default\":false},\"preferred_format\":{\"type\":\"string\",\"enum\":[\"epub\",\"pdf\"],\"default\":\"epub\"}},\"additionalProperties\":false}",
                "admin_form": {
                  "fields": [
                    {
                      "key": "allow_http",
                      "label": "Allow HTTP",
                      "description": "Permit unencrypted HTTP for a trusted connection.",
                      "control": 5,
                      "default_value": false
                    },
                    {
                      "key": "allow_pdf",
                      "label": "Allow PDF",
                      "description": "Permit PDF requests on this connection.",
                      "control": 5,
                      "default_value": false
                    },
                    {
                      "key": "preferred_format",
                      "label": "Ebook format",
                      "control": 6,
                      "default_value": "epub",
                      "options": [
                        {
                          "value": "epub",
                          "label": "EPUB"
                        },
                        {
                          "value": "pdf",
                          "label": "PDF"
                        }
                      ],
                      "dynamic_options": true
                    }
                  ]
                }
              }
            ],
            "metadata": {
              "supported_media_types": [
                "book"
              ]
            },
            "request_router": {
              "wording": {
                "step": "Acquiring",
                "queued": {
                  "label": "Searching",
                  "detail": "Bookwarehouse is searching for the ebook."
                },
                "downloading": {
                  "label": "Downloading",
                  "detail": "Bookwarehouse is downloading the ebook."
                }
              }
            }
          }
        ],
        "presentation": {
          "display_name": "Bookwarehouse ebook requests",
          "summary": "Routes approved ebook requests to Bookwarehouse.",
          "description_markdown": "Requests EPUB ebooks by ISBN and tracks Bookwarehouse acquisition separately from availability in a Bloem library.",
          "setup_markdown": "Configure a Bookwarehouse connection, enable the ebook request policy for the organization, and bind the native ebook library. Ebook requests are disabled by default. Audiobook requests use the separate Bloem workflow and have no automatic acquisition backend.",
